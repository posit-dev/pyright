{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./out",
        "lib": [
            "es2019",
            "WebWorker",
            "ScriptHost"
        ],
        "paths": {
            "pyright-internal/*": [
                "../pyright-internal/src/*"
            ]
        },
        "typeRoots": ["./node_modules/@types", "../pyright-internal/typings"]
    },
    "include": [
        "src/**/*",
        "**/*.js",
        "../pyright-internal/typings/promise.d.ts",
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out"
    ]
}
